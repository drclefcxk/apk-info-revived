{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs2022",
      "displayName": "MSVC 2022 (Visual Studio generator)",
      "description": "Default preset. Matches .\\build.ps1 and produces build\\Release\\*.exe",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "D:/SDK/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "Slint_DIR": "D:/SDK/slint/lib/cmake/Slint"
      }
    },
    {
      "name": "ninja",
      "displayName": "MSVC 2022 + Ninja (single config)",
      "description": "For Visual Studio Code's CMake Tools; uses its own build directory so it never clashes with the VS generator",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "D:/SDK/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "Slint_DIR": "D:/SDK/slint/lib/cmake/Slint"
      }
    }
  ],
  "buildPresets": [
    { "name": "vs2022-release", "configurePreset": "vs2022", "configuration": "Release" },
    { "name": "vs2022-debug", "configurePreset": "vs2022", "configuration": "Debug" },
    { "name": "ninja-release", "configurePreset": "ninja" },
    { "name": "ninja-debug", "configurePreset": "ninja", "configuration": "Debug" }
  ]
}
