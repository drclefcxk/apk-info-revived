// Windows resources for ApkInfo.exe.
//
// The icons are compiled into the executable so the window/taskbar icon can be
// switched at runtime by resource id (LoadIconW(instance, MAKEINTRESOURCEW(...)))
// without depending on files next to the exe. The very same .ico files are also
// shipped as loose files for the shell association (DefaultIcon); see
// Register-FileAssociations.ps1.
//
// The files are generated by tools/make_icons.py - edit that script, not the art.
//
// Resource ids (keep in sync with src/main.cpp):
//   101 app       application icon (magnifier badge)
//   102 apk       .apk document (Android *and* Alpine packages)
//   103 apks      .apks/.apkm/.xapk split bundle
//   104 android   detected Android package (window icon)
//   105 alpine    detected Alpine package (window icon)

// Numeric ids on purpose: an unquoted, undefined token would create a *string*
// named resource, which LoadIconW/LoadImageW(MAKEINTRESOURCEW(id)) cannot reach
// and which makes the shell pick whichever icon sorts first.
#define IDI_APPICON 101
#define IDI_APK     102
#define IDI_APKS    103
#define IDI_ANDROID 104
#define IDI_ALPINE  105

IDI_APPICON  ICON  "app.ico"
IDI_APK      ICON  "apk.ico"
IDI_APKS     ICON  "apks.ico"
IDI_ANDROID  ICON  "android.ico"
IDI_ALPINE   ICON  "alpine.ico"

1 VERSIONINFO
FILEVERSION     1,1,1,0
PRODUCTVERSION  1,1,1,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "APK Info Revived contributors"
            VALUE "FileDescription",  "APK Info - Revived (Android / Alpine package viewer)"
            VALUE "FileVersion",      "1.1.1.0"
            VALUE "InternalName",     "ApkInfo"
            VALUE "LegalCopyright",   "APK Info Revived contributors"
            VALUE "OriginalFilename", "ApkInfo.exe"
            VALUE "ProductName",      "APK Info - Revived"
            VALUE "ProductVersion",   "1.1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
