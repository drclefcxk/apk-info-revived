// APK Info — Revived: main window + the section viewer window.
//
// One screen for two very different package worlds (Android apk/apks and Alpine
// apk): the C++ side flattens either package into rows, so this view stays dumb.
//
// Layout notes
//  * The window chrome is plain layouts; the tabbed panel positions its three
//    bands (tab bar, separator, list) with explicit geometry, which keeps the
//    list at a deterministic size regardless of how the surrounding layout
//    distributes space.
//  * Information rows are a virtualised ListView: section header, label/value
//    rows, full width monospace lines and a "show all (N)" button for sections
//    with too many entries. The first few entries are always shown with exactly
//    the same rendering as the basic information.
//  * "Show all" opens TextViewer: a separate window whose body is one read-only
//    text box (selectable, Ctrl+C, own scrollbar).
//  * The Contents tab is a collapsed tree: only visible nodes become rows, which
//    is what keeps a 20000 entry package responsive.
import { VerticalBox, HorizontalBox, Button, ScrollView, ListView, TextEdit, LineEdit, CheckBox, ComboBox } from "std-widgets.slint";

// Kind: 0 = section header, 1 = label / value row, 2 = full width monospace line,
//       4 = "show all" button, 5 = file tree node, 6 = split bundle member
export struct InfoRowItem {
    kind: int,
    label: string,
    value: string,
    hint: string,
    mono: bool,
    indent: int,
    toggle: int,
    payload: int,
}

// One selectable device on the install page.
export struct DeviceItem {
    label: string,   // "Pixel 7  (emulator-5554)  ·  device"
    serial: string,
    state: string,
    usable: bool,    // state == "device"
}

// A toolbar button that never touches the bar edges: the container fills the
// bar, the button itself keeps a 30px height and is centred vertically.
component ToolbarButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> actionable: true;
    callback clicked();
    background: transparent;

    button := Button {
        x: 0px;
        width: parent.width;
        height: 30px;
        y: (parent.height - self.height) / 2;
        text: root.text;
        primary: root.primary;
        enabled: root.actionable;
        clicked => { root.clicked(); }
    }
}

// A button that keeps its 30px height inside a horizontal layout: layouts size
// their children themselves, so the height has to be applied by a wrapper (the same
// trick the main toolbar uses).
component StripButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    background: transparent;

    b := Button {
        x: 0px;
        width: parent.width;
        height: 30px;
        y: (parent.height - self.height) / 2;
        text: root.text;
        clicked => { root.clicked(); }
    }
}

component TabLabel inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();
    height: 100%;
    width: caption.preferred-width + 28px;
    background: transparent;

    caption := Text {
        x: 14px;
        y: 0px;
        height: 100%;
        text: root.label;
        font-size: 13px;
        font-weight: root.active ? 700 : 400;
        color: root.active ? #1d2330 : #74808f;
        vertical-alignment: center;
    }
    Rectangle {
        y: root.height - 2px;
        height: 2px;
        width: root.width;
        background: root.active ? #2b6ce0 : transparent;
    }
    TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// A separate window showing one long section: the body is a single read-only text
// box, so the whole list can be selected and copied with Ctrl+C.
export component TextViewer inherits Window {
    title: root.viewer-title;
    preferred-width: 720px;
    preferred-height: 560px;
    min-width: 420px;
    min-height: 260px;
    background: #f5f6f8;

    in-out property <string> viewer-title: "Details";
    in-out property <string> viewer-text;
    in-out property <string> viewer-hint;
    in-out property <string> label-close: "Close";

    callback close-requested();

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 46px;
            background: #ffffff;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 10px;
                spacing: 10px;
                alignment: center;
                Text {
                    text: root.viewer-title;
                    font-size: 14px;
                    font-weight: 700;
                    color: #1d2330;
                    vertical-alignment: center;
                }
                Text {
                    text: root.viewer-hint;
                    font-size: 12px;
                    color: #8b95a3;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                // Wrapped: a bare Button inside a layout stretched over the whole
                // 46px header. StripButton keeps 30px, like the main toolbar.
                close := StripButton {
                    width: 88px;
                    text: root.label-close;
                    clicked => { root.close-requested(); }
                }
            }
        }
        Rectangle { height: 1px; background: #e3e6ea; }

        Rectangle {
            x: 12px;
            width: parent.width - 24px;
            vertical-stretch: 1;
            background: #ffffff;

            body := TextEdit {
                x: 10px;
                y: 8px;
                width: parent.width - 20px;
                height: parent.height - 16px;
                text: root.viewer-text;
                read-only: true;
                wrap: word-wrap;
                font-size: 12px;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "APK Info — Revived";
    preferred-width: 1180px;
    preferred-height: 800px;
    min-width: 880px;
    min-height: 560px;
    background: #f5f6f8;

    in-out property <[InfoRowItem]> rows;
    in-out property <[InfoRowItem]> contents-rows;
    in-out property <string> app-title;
    in-out property <string> app-subtitle;
    in-out property <string> app-badge;
    in-out property <string> status-text;
    in-out property <string> contents-title: "Contents";
    in-out property <string> file-name;
    in-out property <image> app-icon;
    in-out property <bool> has-icon: false;
    in-out property <bool> has-error: false;
    in-out property <bool> has-install-target: false;
    in-out property <string> error-text;
    in-out property <[string]> warnings;
    in-out property <int> tab: 0;

    // localised chrome text, pushed in from C++ (see src/i18n.cpp)
    in-out property <string> label-open: "Open package…";
    in-out property <string> label-reload: "Reload";
    in-out property <string> label-information: "Information";
    in-out property <string> label-notes: "Notes";
    in-out property <string> label-no-preview: "no preview";
    in-out property <string> label-copy-all: "Copy all";
    in-out property <string> label-install: "Install";
    in-out property <string> label-settings: "Settings";
    in-out property <string> label-dump: "Dump…";
    in-out property <string> label-export-icon: "Export icon…";

    callback open-requested();
    callback reload-requested();
    callback install-requested();
    callback settings-requested();
    callback copy-all-requested();
    callback dump-requested();
    callback export-icon-requested();
    callback info-row-clicked(int);
    callback contents-row-clicked(int);

    VerticalLayout {
        spacing: 0px;

        // ------------------------------------------------------------------ top bar
        //
        // Explicit geometry: a text block on the left and a fixed-width button
        // cluster pinned to the right edge. Laying these out in one horizontal
        // layout let the elided status text steal width from the buttons, which
        // pushed the last button past the window edge.
        Rectangle {
            height: 58px;
            background: #ffffff;

            // left: title + status
            Rectangle {
                x: 18px;
                y: 0px;
                width: parent.width - 18px - 814px;
                height: 100%;
                background: transparent;
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "APK Info";
                        font-size: 17px;
                        font-weight: 700;
                        color: #1d2330;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Revived";
                        font-size: 12px;
                        color: #8b95a3;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text {
                        text: root.status-text;
                        font-size: 12px;
                        color: #6b7480;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        overflow: elide;
                    }
                }
            }

            // right: copy / dump / export / install / reload / open / settings
            // (88 + 88 + 104 + 96 + 88 + 148 + 88 + 6*10 = 760)
            HorizontalLayout {
                x: parent.width - 778px;
                y: 0px;
                width: 760px;
                height: 100%;
                spacing: 10px;
                ToolbarButton {
                    width: 88px;
                    text: root.label-copy-all;
                    clicked => { root.copy-all-requested(); }
                }
                ToolbarButton {
                    width: 88px;
                    text: root.label-dump;
                    clicked => { root.dump-requested(); }
                }
                ToolbarButton {
                    width: 104px;
                    text: root.label-export-icon;
                    actionable: root.has-icon;
                    clicked => { root.export-icon-requested(); }
                }
                ToolbarButton {
                    width: 96px;
                    text: root.label-install;
                    primary: root.has-install-target;
                    actionable: root.has-install-target;
                    clicked => { root.install-requested(); }
                }
                ToolbarButton {
                    width: 88px;
                    text: root.label-reload;
                    clicked => { root.reload-requested(); }
                }
                ToolbarButton {
                    width: 148px;
                    text: root.label-open;
                    primary: true;
                    clicked => { root.open-requested(); }
                }
                ToolbarButton {
                    width: 88px;
                    text: root.label-settings;
                    clicked => { root.settings-requested(); }
                }
            }
        }
        Rectangle { height: 1px; background: #e3e6ea; }

        // -------------------------------------------------------------- error banner
        if root.has-error: Rectangle {
            background: #fdecec;
            border-color: #f3bcbc;
            border-width: 1px;
            HorizontalLayout {
                padding: 10px;
                spacing: 8px;
                alignment: center;
                Text { text: "⚠"; color: #b42318; font-size: 14px; }
                Text {
                    text: root.error-text;
                    color: #b42318;
                    font-size: 13px;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
            }
        }

        // -------------------------------------------------------------------- body
        HorizontalLayout {
            spacing: 12px;
            padding: 14px;

            // ---- left: identity card
            Rectangle {
                width: 320px;
                background: #ffffff;
                border-radius: 10px;
                border-width: 1px;
                border-color: #e3e6ea;
                VerticalLayout {
                    padding: 18px;
                    spacing: 10px;

                    Rectangle {
                        height: 150px;
                        border-radius: 14px;
                        background: #f0f2f5;
                        if root.has-icon: Image {
                            source: root.app-icon;
                            image-fit: contain;
                            width: 100%;
                            height: 100%;
                        }
                        if !root.has-icon: Text {
                            text: root.label-no-preview;
                            color: #a6aebb;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: root.app-title;
                        font-size: 18px;
                        font-weight: 700;
                        color: #1d2330;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.app-subtitle;
                        font-size: 12px;
                        color: #6b7480;
                        wrap: word-wrap;
                    }
                    if root.app-badge != "": Text {
                        text: root.app-badge;
                        font-size: 12px;
                        font-weight: 600;
                        color: #2b4a86;
                    }
                    Text {
                        text: root.file-name;
                        font-size: 11px;
                        color: #98a1ae;
                        wrap: word-wrap;
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }

                    if root.warnings.length > 0: VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: root.label-notes;
                            font-size: 11px;
                            font-weight: 700;
                            color: #8b95a3;
                        }
                        for warning in root.warnings: Text {
                            text: "• " + warning;
                            font-size: 11px;
                            color: #8a6d3b;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // ---- right: tabbed panel (explicit geometry, see file header)
            Rectangle {
                horizontal-stretch: 1;
                background: #ffffff;
                border-radius: 10px;
                border-width: 1px;
                border-color: #e3e6ea;

                // tab bar
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 42px;
                    background: transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        TabLabel {
                            label: root.label-information;
                            active: root.tab == 0;
                            clicked => { root.tab = 0; }
                        }
                        TabLabel {
                            label: root.contents-title;
                            active: root.tab == 1;
                            clicked => { root.tab = 1; }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                }
                Rectangle {
                    x: 0px;
                    y: 42px;
                    width: parent.width;
                    height: 1px;
                    background: #e9ecf0;
                }

                // information
                ListView {
                    x: 0px;
                    y: 43px;
                    width: parent.width;
                    height: parent.height - 43px;
                    visible: root.tab == 0;

                    for row[index] in root.rows: Rectangle {
                        height: row.kind == 0 ? 38px : (row.kind == 4 ? 34px : 26px);
                        background: transparent;

                        // section header
                        if row.kind == 0: Text {
                            x: 22px;
                            y: 0px;
                            height: 100%;
                            width: parent.width - 44px;
                            text: row.value;
                            font-size: 12px;
                            font-weight: 700;
                            color: #6b7480;
                            vertical-alignment: bottom;
                            overflow: elide;
                        }
                        // label / value
                        if row.kind == 1: HorizontalLayout {
                            x: 22px;
                            width: parent.width - 44px;
                            height: 100%;
                            spacing: 10px;
                            Text {
                                width: 172px;
                                text: row.label + ":";
                                font-size: 13px;
                                color: #74808f;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            // A read-only text input keeps the selection machinery
                            // Slint's Text element does not have, so the value can be
                            // selected and copied row by row.
                            TextInput {
                                horizontal-stretch: 1;
                                text: row.value;
                                read-only: true;
                                single-line: true;
                                font-size: 13px;
                                color: #1d2330;
                                vertical-alignment: center;
                                font-family: row.mono ? "Consolas" : "Segoe UI";
                            }
                        }
                        // full width monospace line (list entries)
                        if row.kind == 2: TextInput {
                            x: 22px;
                            y: 0px;
                            width: parent.width - 44px;
                            height: 100%;
                            text: row.value;
                            read-only: true;
                            single-line: true;
                            font-size: 12px;
                            color: #1d2330;
                            vertical-alignment: center;
                            font-family: "Consolas";
                        }
                        // "show all (N)" - opens the viewer window for this section
                        if row.kind == 4: Rectangle {
                            x: 22px;
                            width: 240px;
                            height: 26px;
                            y: 4px;
                            border-radius: 6px;
                            background: show-all-area.has-hover ? #e8effc : #f2f5fa;
                            border-width: 1px;
                            border-color: #d5e0f5;

                            Text {
                                x: 10px;
                                height: 100%;
                                text: row.label;
                                font-size: 12px;
                                font-weight: 600;
                                color: #2b6ce0;
                                vertical-alignment: center;
                            }
                            show-all-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.info-row-clicked(index); }
                            }
                        }
                    }
                }

                // contents: file tree or split members (virtualised)
                ListView {
                    x: 0px;
                    y: 43px;
                    width: parent.width;
                    height: parent.height - 43px;
                    visible: root.tab == 1;

                    for row[index] in root.contents-rows: Rectangle {
                        height: 26px;
                        background: tree-hover.has-hover && row.toggle != 0 ? #f4f7fb : transparent;

                        // Click target for expanding a directory. Declared before the
                        // row content (later siblings sit on top).
                        tree-hover := TouchArea {
                            mouse-cursor: row.toggle != 0 ? pointer : default;
                            clicked => { root.contents-row-clicked(index); }
                        }

                        // file tree node
                        if row.kind == 5: HorizontalLayout {
                            x: 18px + row.indent * 14px;
                            width: parent.width - 36px - row.indent * 14px;
                            height: 100%;
                            spacing: 6px;
                            Text {
                                width: 14px;
                                text: row.toggle == 2 ? "▾" : (row.toggle == 1 ? "▸" : "");
                                font-size: 10px;
                                color: #8b95a3;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: row.label;
                                font-family: "Consolas";
                                font-size: 12px;
                                color: #1d2330;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            Text {
                                text: row.value;
                                font-size: 11px;
                                color: #8b95a3;
                                width: 110px;
                                horizontal-alignment: right;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                        // split bundle member
                        if row.kind == 6: HorizontalLayout {
                            x: 18px;
                            width: parent.width - 36px;
                            height: 100%;
                            spacing: 12px;
                            Text {
                                text: row.label;
                                font-family: "Consolas";
                                font-size: 12px;
                                color: #1d2330;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Text {
                                text: row.hint;
                                font-size: 11px;
                                color: #8b95a3;
                                width: 190px;
                                horizontal-alignment: right;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            Text {
                                text: row.value;
                                font-size: 12px;
                                color: #4b5563;
                                width: 100px;
                                horizontal-alignment: right;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
// InstallWindow and SettingsWindow, appended to ui/main.slint.
//
// InstallWindow is the Android built-in installer: pick a device, optionally pair or
// connect over Wi-Fi, choose the install options and watch the adb output. Alpine
// packages never open it - they always run the command configured in the settings.
//
// SettingsWindow holds the language (it used to live in the toolbar), the install
// behaviour for both package worlds, the adb path and the placeholder reference.

export component InstallWindow inherits Window {
    title: root.window-title;
    preferred-width: 980px;
    preferred-height: 700px;
    min-width: 760px;
    min-height: 520px;
    background: #f5f6f8;

    in-out property <string> window-title: "Install";
    in-out property <string> package-line;    // "Lawnchair · 1.0.0 · com.example"
    in-out property <string> adb-line;        // where adb was found (or "not found")
    in-out property <string> device-hint;     // "Selected: ..." / "no device selected"
    in-out property <[DeviceItem]> devices;
    in-out property <int> device-index: -1;
    in-out property <string> endpoint;
    in-out property <string> pairing-code;
    in-out property <string> mdns-text;
    in-out property <string> log-text;
    in-out property <bool> busy: false;
    in-out property <bool> replace: true;
    in-out property <bool> grant: false;
    in-out property <bool> downgrade: false;

    // localised chrome (pushed in from C++)
    in-out property <string> label-devices: "Devices";
    in-out property <string> label-refresh: "Refresh";
    in-out property <string> label-discover: "Discover";
    in-out property <string> label-wireless: "Wireless debugging";
    in-out property <string> label-endpoint: "Address (host:port)";
    in-out property <string> label-code: "Pairing code";
    in-out property <string> label-connect: "Connect";
    in-out property <string> label-disconnect: "Disconnect";
    in-out property <string> label-pair: "Pair";
    in-out property <string> label-options: "Install options";
    in-out property <string> label-replace: "Replace existing (-r)";
    in-out property <string> label-grant: "Grant all permissions (-g)";
    in-out property <string> label-downgrade: "Allow downgrade (-d)";
    in-out property <string> label-log: "adb output";
    in-out property <string> label-install: "Install";
    in-out property <string> label-close: "Close";
    in-out property <string> label-empty: "No device - connect one, or pair over Wi-Fi";
    in-out property <string> hint-endpoint: "192.168.1.5:5555";
    in-out property <string> hint-code: "6-digit code";

    callback refresh-requested();
    callback discover-requested();
    callback connect-requested();
    callback disconnect-requested();
    callback pair-requested();
    callback install-requested();
    callback close-requested();
    callback device-selected(int);
    callback endpoint-edited(string);
    callback code-edited(string);

    VerticalLayout {
        spacing: 0px;

        // ------------------------------------------------------------ header
        Rectangle {
            height: 46px;
            background: #ffffff;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 10px;
                spacing: 12px;
                alignment: center;
                Text {
                    text: root.window-title;
                    font-size: 14px;
                    font-weight: 700;
                    color: #1d2330;
                    vertical-alignment: center;
                }
                Text {
                    text: root.package-line;
                    font-size: 12px;
                    color: #6b7480;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.busy: Text {
                    text: "⏳";
                    font-size: 14px;
                    vertical-alignment: center;
                }
                StripButton {
                    width: 88px;
                    text: root.label-close;
                    clicked => { root.close-requested(); }
                }
            }
        }
        Rectangle { height: 1px; background: #e3e6ea; }

        // -------------------------------------------------------------- body
        HorizontalLayout {
            spacing: 12px;
            padding: 12px;

            // ---- left: devices + wireless
            VerticalBox {
                width: 380px;
                spacing: 10px;

                Rectangle {
                    background: #ffffff;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #e3e6ea;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        HorizontalLayout {
                            height: 22px;
                            Text {
                                text: root.label-devices;
                                font-size: 12px;
                                font-weight: 700;
                                color: #6b7480;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: root.device-hint;
                                font-size: 11px;
                                color: #8b95a3;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        Rectangle {
                            height: 176px;
                            background: #fafbfc;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #eceff3;

                            if root.devices.length == 0: Text {
                                text: root.label-empty;
                                font-size: 12px;
                                color: #a6aebb;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                            ListView {
                                for device[index] in root.devices: Rectangle {
                                    height: 30px;
                                    background: index == root.device-index ? #e8effc : transparent;

                                    Text {
                                        x: 10px;
                                        width: parent.width - 20px;
                                        height: 100%;
                                        text: (index == root.device-index ? "◉  " : "○  ") + device.label;
                                        font-size: 12px;
                                        color: device.usable ? #1d2330 : #98a1ae;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.device-selected(index); }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            height: 32px;
                            spacing: 8px;
                            StripButton {
                                width: 96px;
                                text: root.label-refresh;
                                clicked => { root.refresh-requested(); }
                            }
                            StripButton {
                                width: 104px;
                                text: root.label-discover;
                                clicked => { root.discover-requested(); }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                    }
                }

                Rectangle {
                    background: #ffffff;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #e3e6ea;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        Text {
                            height: 20px;
                            text: root.label-wireless;
                            font-size: 12px;
                            font-weight: 700;
                            color: #6b7480;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            height: 30px;
                            spacing: 6px;
                            Text {
                                width: 120px;
                                text: root.label-endpoint;
                                font-size: 12px;
                                color: #74808f;
                                vertical-alignment: center;
                            }
                            LineEdit {
                                horizontal-stretch: 1;
                                text: root.endpoint;
                                placeholder-text: root.hint-endpoint;
                                edited(text) => { root.endpoint-edited(text); }
                            }
                        }
                        HorizontalLayout {
                            height: 30px;
                            spacing: 6px;
                            Text {
                                width: 120px;
                                text: root.label-code;
                                font-size: 12px;
                                color: #74808f;
                                vertical-alignment: center;
                            }
                            LineEdit {
                                horizontal-stretch: 1;
                                text: root.pairing-code;
                                placeholder-text: root.hint-code;
                                edited(text) => { root.code-edited(text); }
                            }
                        }
                        HorizontalLayout {
                            height: 32px;
                            spacing: 8px;
                            StripButton {
                                width: 84px;
                                text: root.label-connect;
                                clicked => { root.connect-requested(); }
                            }
                            StripButton {
                                width: 96px;
                                text: root.label-disconnect;
                                clicked => { root.disconnect-requested(); }
                            }
                            StripButton {
                                width: 72px;
                                text: root.label-pair;
                                clicked => { root.pair-requested(); }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        Text {
                            text: root.mdns-text;
                            font-size: 11px;
                            color: #8b95a3;
                            wrap: word-wrap;
                            visible: root.mdns-text != "";
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; background: transparent; }

                Rectangle {
                    height: 40px;
                    background: transparent;
                    Text {
                        x: 4px;
                        width: 372px;
                        height: 100%;
                        text: root.adb-line;
                        font-size: 11px;
                        color: #8b95a3;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            // ---- right: options + log + actions
            Rectangle {
                horizontal-stretch: 1;
                background: #ffffff;
                border-radius: 10px;
                border-width: 1px;
                border-color: #e3e6ea;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Text {
                        height: 20px;
                        text: root.label-options;
                        font-size: 12px;
                        font-weight: 700;
                        color: #6b7480;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        height: 28px;
                        spacing: 14px;
                        CheckBox {
                            text: root.label-replace;
                            checked: root.replace;
                            toggled() => { root.replace = self.checked; }
                        }
                        CheckBox {
                            text: root.label-grant;
                            checked: root.grant;
                            toggled() => { root.grant = self.checked; }
                        }
                        CheckBox {
                            text: root.label-downgrade;
                            checked: root.downgrade;
                            toggled() => { root.downgrade = self.checked; }
                        }
                    }

                    Text {
                        height: 20px;
                        text: root.label-log;
                        font-size: 12px;
                        font-weight: 700;
                        color: #6b7480;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        background: #fbfcfd;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #eceff3;
                        log := TextEdit {
                            x: 8px;
                            y: 6px;
                            width: parent.width - 16px;
                            height: parent.height - 12px;
                            text: root.log-text;
                            read-only: true;
                            wrap: word-wrap;
                            font-size: 12px;
                        }
                    }
                    HorizontalLayout {
                        height: 34px;
                        spacing: 8px;
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        StripButton {
                            width: 120px;
                            text: root.label-install;
                            clicked => { root.install-requested(); }
                        }
                        StripButton {
                            width: 88px;
                            text: root.label-close;
                            clicked => { root.close-requested(); }
                        }
                    }
                }
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: root.window-title;
    preferred-width: 860px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 520px;
    background: #f5f6f8;

    in-out property <string> window-title: "Settings";
    // language: 0 = follow the system, 1 = 中文, 2 = English (constant, bilingual list:
    // a replaced model makes the ComboBox reset its selection)
    in-out property <int> language-index: 0;
    in-out property <[string]> language-options: ["跟随系统 / System", "中文", "English"];
    // install behaviour
    in-out property <int> android-mode-index: 0;  // 0 = built-in, 1 = command
    in-out property <[string]> android-mode-options: ["内置安装器 / Built-in", "外部命令 / Command line"];
    in-out property <string> android-command;
    in-out property <string> alpine-command;
    in-out property <string> adb-path;
    in-out property <string> placeholder-help;
    in-out property <string> preview-text;
    in-out property <string> note-text;

    in-out property <string> label-language-section: "Language";
    in-out property <string> label-language: "Interface language";
    in-out property <string> label-android-section: "Install button - Android packages";
    in-out property <string> label-android-mode: "Install method";
    in-out property <string> label-android-command: "Command line";
    in-out property <string> label-alpine-section: "Install button - Alpine packages";
    in-out property <string> label-alpine-command: "Command line";
    in-out property <string> label-adb: "adb path (empty = search PATH and the SDK)";
    in-out property <string> label-placeholders: "Placeholders";
    in-out property <string> label-preview: "Preview for the open package";
    in-out property <string> label-save: "Save";
    in-out property <string> label-cancel: "Cancel";

    callback save-requested();
    callback cancel-requested();
    callback android-command-edited(string);
    callback alpine-command-edited(string);
    callback adb-path-edited(string);

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 46px;
            background: #ffffff;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 10px;
                spacing: 12px;
                alignment: center;
                Text {
                    text: root.window-title;
                    font-size: 14px;
                    font-weight: 700;
                    color: #1d2330;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                StripButton {
                    width: 88px;
                    text: root.label-cancel;
                    clicked => { root.cancel-requested(); }
                }
            }
        }
        Rectangle { height: 1px; background: #e3e6ea; }

        ScrollView {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: content.preferred-height;

            content := VerticalLayout {
                padding: 14px;
                spacing: 12px;

                // -------- language
                Rectangle {
                    background: #ffffff;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #e3e6ea;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        Text {
                            height: 20px;
                            text: root.label-language-section;
                            font-size: 12px;
                            font-weight: 700;
                            color: #6b7480;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            height: 30px;
                            spacing: 8px;
                            Text {
                                width: 320px;
                                text: root.label-language;
                                font-size: 13px;
                                color: #1d2330;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                width: 220px;
                                alignment: center;
                                ComboBox {
                                    model: root.language-options;
                                    current-index: root.language-index;
                                    selected(value) => { root.language-index = self.current-index; }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                    }
                }

                // -------- android
                Rectangle {
                    background: #ffffff;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #e3e6ea;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        Text {
                            height: 20px;
                            text: root.label-android-section;
                            font-size: 12px;
                            font-weight: 700;
                            color: #6b7480;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            height: 30px;
                            spacing: 8px;
                            Text {
                                width: 320px;
                                text: root.label-android-mode;
                                font-size: 13px;
                                color: #1d2330;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                width: 260px;
                                alignment: center;
                                ComboBox {
                                    model: root.android-mode-options;
                                    current-index: root.android-mode-index;
                                    selected(value) => { root.android-mode-index = self.current-index; }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        Text {
                            height: 20px;
                            text: root.label-android-command;
                            font-size: 12px;
                            color: #74808f;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            height: 62px;
                            background: #fbfcfd;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #eceff3;
                            LineEdit {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 26px;
                                y: (parent.height - self.height) / 2;
                                text: root.android-command;
                                font-size: 12px;
                                edited(text) => { root.android-command-edited(text); }
                            }
                        }
                    }
                }

                // -------- alpine
                Rectangle {
                    background: #ffffff;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #e3e6ea;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        Text {
                            height: 20px;
                            text: root.label-alpine-section;
                            font-size: 12px;
                            font-weight: 700;
                            color: #6b7480;
                            vertical-alignment: center;
                        }
                        Text {
                            height: 20px;
                            text: root.label-alpine-command;
                            font-size: 12px;
                            color: #74808f;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            height: 62px;
                            background: #fbfcfd;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #eceff3;
                            LineEdit {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 26px;
                                y: (parent.height - self.height) / 2;
                                text: root.alpine-command;
                                font-size: 12px;
                                edited(text) => { root.alpine-command-edited(text); }
                            }
                        }
                        Text {
                            height: 20px;
                            text: root.label-adb;
                            font-size: 12px;
                            color: #74808f;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            height: 30px;
                            LineEdit {
                                horizontal-stretch: 1;
                                text: root.adb-path;
                                placeholder-text: "C:\\platform-tools\\adb.exe";
                                edited(text) => { root.adb-path-edited(text); }
                            }
                        }
                    }
                }

                // -------- placeholder reference
                Rectangle {
                    background: #ffffff;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #e3e6ea;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        Text {
                            height: 20px;
                            text: root.label-placeholders;
                            font-size: 12px;
                            font-weight: 700;
                            color: #6b7480;
                            vertical-alignment: center;
                        }
                        // Fourteen entries do not fit a card, so the list scrolls on
                        // its own and the footer stays where it is.
                        ScrollView {
                            height: 190px;
                            viewport-width: self.width;
                            viewport-height: help.preferred-height;

                            help := Text {
                                width: parent.width - 12px;
                                text: root.placeholder-help;
                                font-size: 12px;
                                color: #4b5563;
                                font-family: "Consolas";
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // -------- preview
                Rectangle {
                    background: #ffffff;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #e3e6ea;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        Text {
                            height: 20px;
                            text: root.label-preview;
                            font-size: 12px;
                            font-weight: 700;
                            color: #6b7480;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.preview-text;
                            font-size: 12px;
                            color: #1d2330;
                            font-family: "Consolas";
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.note-text;
                            font-size: 11px;
                            color: #8b95a3;
                            wrap: word-wrap;
                            visible: root.note-text != "";
                        }
                    }
                }

            }
        }

        Rectangle { height: 1px; background: #e3e6ea; }
        Rectangle {
            height: 56px;
            background: #ffffff;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;
                alignment: center;
                Rectangle { horizontal-stretch: 1; background: transparent; }
                StripButton {
                    width: 110px;
                    text: root.label-save;
                    clicked => { root.save-requested(); }
                }
                StripButton {
                    width: 100px;
                    text: root.label-cancel;
                    clicked => { root.cancel-requested(); }
                }
            }
        }
    }
}
